<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 화면: GitHub 아이디 설정, 위젯 추가·새로고침, 사용 안내 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="GrassManager"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 지금 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refresh"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:stateListAnimator="@null"
                    android:text="새로고침"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/open_home"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:stateListAnimator="@null"
                    android:text="홈페이지 열기"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 아이디 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GitHub 아이디"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/user"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:imeOptions="actionDone"
                    android:inputType="text|textNoSuggestions"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/save"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:text="저장"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="GitHub 공개 잔디 페이지를 읽어서 토큰이 필요 없어요. 비공개 저장소 기여까지 세려면 GitHub 프로필 설정의 Private contributions를 켜 두세요."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 위젯 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈 화면 위젯"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/add_widget"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="홈 화면에 위젯 추가"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="• 버튼이 안 되면: 홈 화면 빈 곳을 길게 누르기 → 위젯 → GrassManager\n• 30분마다(그리고 자정에) 자동으로 갱신돼요. push 직후에는 위젯의 ⟳ 버튼을 누르세요.\n• 위젯을 누르면 Grass Manager 홈페이지가 열려요.\n• 다크/라이트는 휴대폰 설정을 따라가요."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
