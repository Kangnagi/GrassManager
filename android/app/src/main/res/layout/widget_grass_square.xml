<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 위젯: 제목 줄(로고·연속 기록·새로고침) / 오늘 칸 + 상태 / 일~토 작은 7칸 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/ok"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="새로고침"
            android:padding="5dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp">

        <FrameLayout
            android:id="@+id/today_frame"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/today_cell"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cell_l0" />

            <TextView
                android:id="@+id/today_count"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="오늘"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mini_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame0"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame1"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame2"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame3"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame4"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame5"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/frame6"
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/cell6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_l0" />

                <ImageView
                    android:id="@+id/ring6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cell_today"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
