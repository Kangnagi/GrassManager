<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 위젯: 오늘 칸(기여 수) + 연속 기록. 글자색이 초록이면 오늘 커밋함, 주황이면 아직 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/today_frame"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/today_cell"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cell_l0" />

        <TextView
            android:id="@+id/today_count"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ok"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
